# secrets and local tooling
.env
.claude/
wandb/
__pycache__/
*.pyc
.DS_Store

# large / derived data (regenerable with the scripts; see README)
sft/data/*.jsonl
sft/data_v3a/*.jsonl
sft/data_v3b/*.jsonl
sft/data_v3b_p1/
sft/gen_v3b/batches/manifest.json

# per-problem model outputs (100+ MB); the aggregated trajectories live in results/
evals/**/*.jsonl
gens/

# one-off scratch scripts written by generation subagents
sft/gen_v3b/gen_batch_*.py
sft/gen_v3b/generate_batch_*.py
sft/gen_v3b/fix_batch_*.py
sft/gen_v3b/build_batch_*.py

# scratch eval checks
evals/gsm8k/_check/

# stage 2 (RLAIF): large derived training sets are regenerable with rlaif/data/*.py; subagent batch scratch is not needed
rlaif/data/persona_patched.jsonl
rlaif/data/math_rows.jsonl
rlaif/data/v4/train.jsonl
rlaif/data/v4_full/train.jsonl
rlaif/data/short/todo/
rlaif/data/short/qa_existing/
rlaif/**/__pycache__/

# stage-2 run artifacts pulled from the pod (adapters ~1 GB per run, merged models 6 GB, pod logs); trainer_state.json files stay tracked
runs/*/checkpoint-*/
runs/*/final_adapter/
runs/*/completions/
runs/*/README.md
models/
logs_pod/

# local tooling / raw data (stage-2 handover, 2026-09-20)
.venv/
sft/data_raw/
rlaif/judge/calibration_raw_*.jsonl
